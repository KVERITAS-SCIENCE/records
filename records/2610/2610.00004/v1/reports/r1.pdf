            "pid": 2632281,
            "ppid": 2632278,
            "command": "awk \n{ print; fflush() }\n/^Epoch: / { ep=$2 }\n/Loss: .*Acc: .*\\/50000\\)/ {\n  match($0, /Loss: [0-9.]+/); l=substr($0,RSTART+6,RLENGTH-6)\n  match($0, /Acc: [0-9.]+/); a=substr($0,RSTART+5,RLENGTH-5)\n  printf \"KVERITAS_METRIC name=train_loss value=%s step=%s\\nKVERITAS_METRIC name=train_acc value=%s step=%s\\n\", l, ep, a, ep; fflush()\n}\n/Loss: .*Acc: .*\\/10000\\)/ {\n  match($0, /Loss: [0-9.]+/); l=substr($0,RSTART+6,RLENGTH-6)\n  match($0, /Acc: [0-9.]+/); a=substr($0,RSTART+5,RLENGTH-5)\n  printf \"KVERITAS_METRIC name=test_loss value=%s step=%s\\nKVERITAS_METRIC name=test_acc value=%s step=%s\\n\", l, ep, a, ep; fflush()\n  last=a; if (a+0\u003ebest+0) best=a\n}\nEND {\n  print \"KVERITAS_PHASE name=summary\"\n  if (last!=\"\") { printf \"KVERITAS_CLAIM metric=final_test_acc value=%s\\nKVERITAS_CLAIM metric=best_test_acc value=%s\\n\", last, best }\n}",

            "pid": 3106939,
            "ppid": 3106936,
            "command": "awk -F| \n{ print; fflush() }\n/^\\|/ \u0026\u0026 NF\u003e=7 {\n  r=$2; gsub(/ /,\"\",r); e=$3; gsub(/ /,\"\",e); t=$6; gsub(/ /,\"\",t); s=$7; gsub(/ /,\"\",s)\n  if (r!=\"\") cur=r\n  if (e==\"eval\" \u0026\u0026 cur!=\"warmup\" \u0026\u0026 cur!=\"run\") {\n    printf \"KVERITAS_METRIC name=tta_val_acc value=%s step=%s\\n\", t, cur\n    printf \"KVERITAS_METRIC name=time_seconds value=%s step=%s\\n\", s, cur\n    fflush()\n  }\n}\n/^Mean:/ {\n  printf \"KVERITAS_PHASE name=summary\\n\"\n  split($0, a, \" \")\n  printf \"KVERITAS_CLAIM metric=mean_tta_val_acc value=%s\\n\", a[2]\n  printf \"KVERITAS_CLAIM metric=std_tta_val_acc value=%s\\n\", a[4]\n  fflush()\n}",

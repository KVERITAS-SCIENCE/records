            "ppid": 2604393,
            "command": "awk -F| \n{ print; fflush() }\n/^\\|/ \u0026\u0026 NF\u003e=9 {\n  e=$2; gsub(/ /,\"\",e)\n  if (e !~ /^[0-9]+$/) next\n  if (e==0) run++\n  for (i=3;i\u003c=8;i++) { v[i]=$i; gsub(/ /,\"\",v[i]) }\n  printf \"KVERITAS_METRIC name=val_acc value=%s step=r%d_e%s\\n\", v[6], run, e\n  if (v[7]!=\"\") ema=v[7]\n  last=1; fflush(); next\n}\n/^-+$/ \u0026\u0026 last==1 {\n  printf \"KVERITAS_METRIC name=final_ema_val_acc value=%s step=%d\\n\", ema, run\n  printf \"KVERITAS_METRIC name=total_time_seconds value=%s step=%d\\n\", v[8], run\n  last=0; fflush()\n}\n/^Mean and variance:/ {\n  s=$0; gsub(/.*\\(/,\"\",s); gsub(/\\).*/,\"\",s); split(s,a,\", *\")\n  print \"KVERITAS_PHASE name=summary\"\n  printf \"KVERITAS_CLAIM metric=mean_final_ema_val_acc value=%s\\n\", a[1]\n  printf \"KVERITAS_CLAIM metric=var_final_ema_val_acc value=%s\\n\", a[2]\n  fflush()\n}",
            "start_at": "2026-10-07T03:10:08.819300868Z"
          },

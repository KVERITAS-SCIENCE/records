        "procs": [
          {
            "pid": 3244446,
            "ppid": 3244444,
            "command": "./train_gpt2cu",
            "start_at": "2026-10-07T09:06:15.756516547Z"
          },
          {
            "pid": 3244447,
            "ppid": 3244444,
            "command": "awk \n{ print; fflush() }\n/^step +[0-9]+\\/[0-9]+ \\| loss/ {\n  match($0, /step +[0-9]+/); split(substr($0,RSTART,RLENGTH), s, \" \"); step = s[2]\n  match($0, /loss [0-9.]+/); split(substr($0,RSTART,RLENGTH), l, \" \")\n  match($0, /[0-9.]+ tok\\/s/); split(substr($0,RSTART,RLENGTH), t, \" \"); tok = t[1]\n  printf \"KVERITAS_METRIC name=train_loss value=%s step=%s\\n\", l[2], step; fflush()\n}\n/^val loss [0-9.]+/ {\n  vl = $3; printf \"KVERITAS_METRIC name=val_loss value=%s step=%d\\n\", vl, step + 0; fflush()\n}\n/^total average iteration time:/ { ms = $5 }\nEND {\n  print \"KVERITAS_PHASE name=summary\"\n  if (vl != \"\") printf \"KVERITAS_CLAIM metric=final_val_loss value=%s\\n\", vl\n  if (ms != \"\") printf \"KVERITAS_CLAIM metric=avg_iteration_ms value=%s\\n\", ms\n  if (tok != \"\") printf \"KVERITAS_CLAIM metric=tokens_per_second value=%s\\n\", tok\n}",
            "start_at": "2026-10-07T09:06:15.756516547Z"
          }
        ]
      },

            "command": "awk \n{ print; fflush() }\n/^\\| end of epoch/ {\n  match($0, /epoch +[0-9]+/); split(substr($0,RSTART,RLENGTH), e, \" \")\n  match($0, /valid loss +[0-9.]+/); split(substr($0,RSTART,RLENGTH), l, \" \")\n  match($0, /valid ppl +[0-9.]+/); split(substr($0,RSTART,RLENGTH), p, \" \")\n  printf \"KVERITAS_METRIC name=valid_loss value=%s step=%s\\nKVERITAS_METRIC name=valid_ppl value=%s step=%s\\n\", l[3], e[2], p[3], e[2]; fflush()\n}\n/^\\| End of training/ {\n  print \"KVERITAS_PHASE name=test\"\n  match($0, /test loss +[0-9.]+/); split(substr($0,RSTART,RLENGTH), l, \" \")\n  match($0, /test ppl +[0-9.]+/); split(substr($0,RSTART,RLENGTH), p, \" \")\n  printf \"KVERITAS_CLAIM metric=test_loss value=%s\\nKVERITAS_CLAIM metric=test_ppl value=%s\\n\", l[3], p[3]; fflush()\n}",
